# JSON string (the texts here hold no control characters)
jstr() { local v=${1//\\/\\\\}; printf '"%s"' "${v//\"/\\\"}"; }

# The one thing to do now, for a new user and the panel's home page: sets ns_step, ns_fix (the frame-vrc arguments
# that do it, "" = none), ns_alt (a second choice), ns_text and ns_opts (the launch options). Read from what is there
# when asked, never waited for: Steam shows its own download progress, the user checks again when it is done.
next_step() {
  refresh_paths
  local ed
  ns_fix="" ns_alt="" ns_opts=""
  if ! ns_opts=$(opts_get 2>/dev/null) || ! steamapi ping >/dev/null 2>&1; then
    ns_step=steam ns_text="Steam does not answer: start Steam, then check again"
    return
  fi
  ed=$(edition)
  if [[ -d $apps/downloading/$appid ]]; then
    ns_step=download ns_text="Steam is downloading $name; check again when it is done"
  elif [[ -z $ed && $(steamapi owned "$appid" 2>/dev/null) != 1 ]]; then
    ns_step=own ns_fix=store ns_text="$name is not in your Steam library: it is free; add it on its store page, then check again"
  elif [[ -z $ed ]]; then
    ns_step=game ns_fix=setup
    ns_text="$name is not installed: set up the PCVR version (then confirm Steam's install prompt), or install the"
    ns_text+=" official version from the Steam store as usual"
  elif [[ $ed == official ]]; then
    ns_step=official ns_fix=setup
    ns_text="the official version (Lepton, Valve's setup)"
    if ours "$ns_opts"; then ns_alt=official ns_text+="; frame-vrc's launch options are still set (official clears them)"; fi
    [[ $(game_build) != pc ]] || ns_text+=": launch $name, Steam updates it to the official build first"
  elif ! deps_all_present; then
    ns_step=deps ns_fix=install-deps ns_text="Steam has to install FEX-Emu, Proton Experimental and the EasyAntiCheat runtime"
  elif [[ $ed != community || $(pfex_state) == missing || $(dfr_state) == missing || $ns_opts != "$(run_line)" ]]; then
    ns_step=patch ns_fix=setup ns_alt=official
    ns_text="the PCVR version is not fully set up (patched FEX, $dfr_name, $name's compatibility tool, launch options)"
  else
    # Steam updates VRChat to the PC build when it is launched: nothing to wait for here
    ns_fix=launch ns_alt=official
    if [[ -f $gamedir/$name.exe ]]; then ns_step=ready ns_text="ready: launch $name"
    else ns_step=update ns_text="patched: update and launch $name (Steam updates it to the PC build first)"; fi
    # an older copy or FEX still runs: setup brings the new one
    [[ $(pfex_state) == ok && $(dfr_state) == ok ]] || ns_text+=". An update of frame-vrc's parts is ready: apply again (setup)"
  fi
}

cmd_next() {
  next_step
  if [[ ${1:-} == --json ]]; then
    printf '{"step":%s,"fix":%s,"alt":%s,"text":%s}\n' "$(jstr "$ns_step")" "$(jstr "$ns_fix")" "$(jstr "$ns_alt")" "$(jstr "$ns_text")"
    return
  fi
  echo "next: $ns_text"
  [[ -z $ns_fix ]] || echo "  frame-vrc $ns_fix"
  [[ -z $ns_alt ]] || echo "  or: frame-vrc $ns_alt"
}

cmd_status() {
  refresh_paths
  local s res tool launch rt
  next_step
  s=$(pfex_state) res=$(res_get) tool=$(compat_tool)
  rt=$(cat "$pfex/.frame-vrc-runtime" 2>/dev/null) || rt=""
  if [[ $ns_opts == "$(run_line)" ]]; then launch=set
  elif ours "$ns_opts"; then launch=stale
  elif [[ -z $ns_opts ]]; then launch=none
  else launch=other; fi
  if [[ ${1:-} == --json ]]; then
    local run=false; running && run=true
    # DFR is always on in ji10me's runtime
    printf '{"version":%s,"fex":%s,"fex_build":%s,"proton":%s,"steam_tool":%s,"resolution":%s,"dfr":"on","runtime":%s,' \
      "$(jstr $VERSION)" "$(jstr "$s")" "$(jstr "$(describe "$pfex")")" "$(jstr "$(dfr_state)")" "$(jstr "$tool")" \
      "${res:-0}" "$(jstr "$rt")"
    printf '"dfr_effective":"on","video":%s,"launch":%s,"game_running":%s,' \
      "$(jstr "$([[ -f $video_pkg/VERSION ]] && echo hw || echo sw)")" "$(jstr $launch)" $run
    printf '"next_step":%s,"next_fix":%s,"next_alt":%s,"build":%s,"edition":%s,"swap_file_mb":%s,"zram_mb":%s}\n' \
