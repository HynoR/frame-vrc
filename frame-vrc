# The official version: Lepton (Steam updates VRChat to the Android build), your own launch options (none, as Steam
# ships them) and resolution. The patched FEX and the Proton copy stay, to switch back with frame-vrc setup;
# frame-vrc uninstall removes them. --quiet: no closing line (uninstall goes on).
cmd_official() {
  wizard_stop_and_clear
  refresh_paths
  quit_first
  steamapi ping >/dev/null 2>&1 || die "Steam does not answer: start Steam, then run this again"
  # also when VRChat is not installed: the choice stays in Steam and would install it on a deleted tool later
  local tool; tool=$(compat_tool)
  if [[ -n $tool && $tool != lepton* ]]; then
    set_compat_tool lepton || die "Steam did not take Lepton"
    echo "$name's compatibility tool: Lepton (the official version; Steam updates $name to it)"
  fi
  if ours "$(opts_get 2>/dev/null || true)"; then cmd_launch_options clear; fi
  if [[ -f $data/resolution.$appid.prev ]]; then (cmd_resolution reset) || echo "frame-vrc: start SteamVR and run: frame-vrc resolution reset" >&2; fi
  [[ ${1:-} == --quiet ]] && return
  steam_fex_restore || true  # it said why; uninstall insists
  echo "official version (Valve's setup): launch $name (Steam updates it to the official build first when needed)."
  echo "Back to the PCVR version: frame-vrc setup"
}

