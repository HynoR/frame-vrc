      "$(swap_mb /home/swapfile | grep . || echo 0)" "$(swap_mb /dev/zram0 | grep . || echo 0)"
    return
  fi
  echo "frame-vrc $VERSION"
  echo "  next        $ns_text"
  echo "  version     $(edition) (Steam's tool: ${tool:-default}; installed build: $(game_build))"
  echo "  fex         $s ($(describe "$pfex")); Steam's FEX-Emu: $(describe "$fex")"
  echo "  proton      $(dfr_state) ($dfr_name)"
  echo "  resolution  ${res:-? (start SteamVR)} (frame-vrc: $(cfg RES))"
  echo "  runtime     ${rt:-not set up} (session supervisor: $(runtime_state))"
  echo "  video       $([[ -f $video_pkg/VERSION ]] && echo "H.264 hardware ($(head -1 "$video_pkg/VERSION" | cut -d: -f1))" || echo "software (no package)")"
  echo "  audio fix   $([[ $(mf_want) == "$mf_pkg/mf.dll" ]] && head -1 "$mf_pkg/VERSION" | cut -d: -f1 || echo "not used (no package, or another Proton Experimental)")"
  echo "  launch      $launch"
}

# Each row: level, group, text and the frame-vrc command that fixes it ("" = none). --json: one array of rows (the VR
# panel draws it and offers the fixes as buttons).
cmd_doctor() {
  local bad=0 json=false group="" rows=()
  [[ ${1:-} == --json ]] && json=true
  row() {  # LEVEL FIX TEXT
    [[ $1 == fail ]] && bad=1
    if $json; then
      rows+=("{\"group\":$(jstr "$group"),\"level\":$(jstr "$1"),\"text\":$(jstr "$3"),\"fix\":$(jstr "$2")}")
    else
      local l; case $1 in ok) l="ok  " ;; warn) l=WARN ;; *) l=FAIL ;; esac
      printf '  %s  %s%s\n' "$l" "$3" "${2:+: frame-vrc $2}"
    fi
  }
  section() { group=$1; $json || echo "$1"; }
  $json || echo "frame-vrc $VERSION doctor"
  section device
  if grep -q '^VARIANT_ID="\?vr' /etc/os-release && [[ $(uname -m) == aarch64 ]]; then
    row ok "" "Steam Frame: SteamOS $(sed -n 's/^VERSION_ID=//p' /etc/os-release) build $(sed -n 's/^BUILD_ID=//p' /etc/os-release)"
  else
    row fail "" "not a Steam Frame (SteamOS VARIANT_ID=vr, aarch64)"
  fi
  row ok "" "memory $(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo) MB available of $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo) MB; max temperature $(($(maxtemp | grep . || echo 0) / 1000)) C"
  local free; free=$(df -Pm "$HOME" | awk 'NR==2{print $4}')
  ((free > 3072)) && row ok "" "disk: $((free / 1024)) GB free" || row warn "" "disk: $free MB free (Proton copy requires 3 GB)"
  curl -fsI -m 5 https://github.com >/dev/null 2>&1 && row ok "" "network: github.com reachable" ||
    row warn "" "network: github.com unreachable (required for setup and update)"
  section steam
  refresh_paths
  steamapi ping >/dev/null 2>&1 && row ok "" "Steam is running" || row fail "" "Steam is not responding (start Steam)"
  local ed tool dep=fail; ed=$(edition) tool=$(compat_tool)
  [[ $ed == official ]] && dep=ok  # the official version needs none of Steam's x86 tools
  local drow did dlbl ddir dextra
  for drow in "${DEPS[@]}"; do
    IFS='|' read -r _ did _ dlbl <<<"$drow"
    ddir=$(dep_path "$did")
    if dep_ready "$did"; then
      dextra=""
      case $did in
        3127680) dextra=" $(describe "$ddir")" ;;
        1493710) dextra=" $(cut -d' ' -f2 "$ddir/version" 2>/dev/null)" ;;
      esac
      row ok "" "${dlbl}${dextra}"
    elif dep_files_ok "$did" "$ddir"; then
      row warn "" "$dlbl is being updated by Steam (setup waits for it to finish)"
    elif dep_downloading "$did"; then
      row $dep install-deps "$dlbl is downloading in Steam"
    elif [[ -d $ddir ]]; then
      row $dep install-deps "$dlbl incomplete in Steam"
    else
      row $dep install-deps "$dlbl not installed"
    fi
    if [[ $did == 3127680 ]]; then
      [[ $(describe "$ddir") != eac-* ]] || row warn "" "Steam's FEX-Emu contains a legacy patched build (run setup or official to restore Valve's build)"
    fi
  done
  section "$name"
  case $ed in
    "") [[ $(steamapi owned "$appid" 2>/dev/null) == 1 ]] && row fail setup "not installed" || row fail store "not in your Steam library" ;;
    official) row ok "" "official version (compatibility tool ${tool:-default}: Lepton)" ;;
    other) row fail setup "compatibility tool '$tool': EAC requires $dfr_name" ;;
    community) row ok "" "PCVR version ($dfr_name)" ;;
  esac
  case $(game_build) in
    pc) row ok "" "PC build installed" ;;
    android) [[ $ed == official ]] && row ok "" "Android build installed" ||
               row warn "" "PC build pending download in Steam (Library > $name > Update)" ;;
  esac
  local cur; cur=$(opts_get 2>/dev/null || true)
  if [[ $ed == official ]]; then
    ours "$cur" && row warn official "frame-vrc launch options are still set" || row ok "" "launch options: ${cur:-none}"
  elif [[ $cur == "$(run_line)" ]]; then row ok "" "launch options configured"
  elif ours "$cur"; then row warn "launch-options set" "outdated frame-vrc launch options"
  elif [[ -n $cur ]]; then row fail "launch-options set" "custom launch options detected (set replaces them; official restores them)"
  else row fail "launch-options set" "launch options not set"; fi
  section "frame-vrc"
  # the official version needs none of it: what is missing is only a note there
  local miss=fail mfix=setup ofix=setup; [[ $ed == official ]] && miss=ok mfix="" ofix=packages
  case $(pfex_state) in
    ok) row ok "" "patched FEX: $(describe "$pfex")" ;;
    old) row warn $ofix "patched FEX $(describe "$pfex"): update available" ;;
    missing) row $miss "$mfix" "patched FEX not configured" ;;
  esac
  [[ -f $dfr_pkg/VERSION ]] && row ok "" "DFR package: $(cat "$dfr_pkg/VERSION")" || row $miss "$mfix" "DFR package not installed"
  case $(dfr_state) in
    ok) row ok "" "$dfr_name (Proton Experimental $(cut -d' ' -f2 "$dfr_dir/version"))" ;;
    old) row warn $ofix "$dfr_name is outdated (update available)" ;;
    missing) row $miss "$mfix" "$dfr_name not configured" ;;
  esac
  local rt; rt=$(cat "$pfex/.frame-vrc-runtime" 2>/dev/null) || rt=""
  if [[ -n $rt ]]; then
    [[ $rt == *"thunks on"* ]] && row ok "" "runtime: $rt" || row warn "" "runtime: $rt (Vulkan thunks disabled)"
  fi
  [[ $(runtime_state) == ok ]] && row ok "" "session supervisor and eye-tracking bridge built" || row $miss "$mfix" "session supervisor and eye-tracking bridge not built"
  [[ $(mf_want) == "$mf_pkg/mf.dll" ]] && row ok "" "audio fix (mf.dll): $(head -1 "$mf_pkg/VERSION")" ||
    row ok "" "audio fix (mf.dll): inactive (package missing or Proton version mismatch)"
  [[ -f $video_pkg/VERSION ]] && row ok "" "H.264 hardware video: $(head -1 "$video_pkg/VERSION")" || row "$([[ $miss == ok ]] && echo ok || echo warn)" "$mfix" "H.264 hardware video package not installed"
  [[ -f $HOME/.config/openvr/openvrpaths.vrpath ]] && row ok "" "OpenVR path registry" || row warn "" "no ~/.config/openvr/openvrpaths.vrpath: start SteamVR once"
  if $json; then (IFS=,; echo "[${rows[*]}]"); return $bad; fi
  ((bad == 0)) && echo "all set" || { echo "fix the FAIL lines above"; return 1; }
}

# ---- commands: FEX --------------------------------------------------------------------------------------------
cmd_build() {
  local jobs=4
  [[ "${1:-}" == --jobs ]] && jobs=${2:?--jobs N}
  local t; for t in clang cmake ninja ld.lld git python3; do command -v $t >/dev/null || die "missing $t"; done
  local free; free=$(df -Pm "$HOME" | awk 'NR==2{print $4}')
  ((free > 5120)) || die "less than 5 GB free in $HOME"
  echo "Building the patched FEX with $jobs jobs (about 5 minutes on 4; the headset gets hot, up to ~98 C measured)."
  echo "Keep it on power and off your head. It stops by itself at 100 C; Ctrl-C stops it too, re-running continues."
  mkdir -p "$work"
  local start=$SECONDS rc=0 bpid
  # Own session, so the heat guard and Ctrl-C can stop every compiler process at once.
  JOBS=$jobs setsid bash -o pipefail -c 'sh "$0" 2>&1 | tee "$1"' "$lib/build-fex.sh" "$work/build.log" &
  bpid=$!
  trap 'pkill -TERM -s "$bpid" 2>/dev/null; die "build stopped; run frame-vrc build again to continue"' INT TERM
  (while kill -0 "$bpid" 2>/dev/null; do
     if (($(maxtemp) >= 100000)); then echo "frame-vrc: 100 C reached, stopping the build" >&2; pkill -TERM -s "$bpid"; fi
     sleep 10
   done) &
  wait "$bpid" || rc=$?
  trap - INT TERM
  ((rc == 0)) || die "build failed (exit $rc), log: $work/build.log"
  rm -f "$work/stage/ASSET"  # built here: no release's package replaces it
  echo "built in $(((SECONDS - start) / 60)) min $(((SECONDS - start) % 60)) s: $(describe "$work/stage"). Next: frame-vrc setup"
}

# The built stage as a release asset for others to fetch: fex-<describe>-steamframe-aarch64.tar.gz + .sha256
cmd_pack() {
  [[ -d $work/stage ]] || die "no build in $work/stage"
  local d n; d=$(describe "$work/stage"); n="fex-$d-steamframe-aarch64.tar.gz"
  # FEX is MIT: its license travels with the binaries.
  [[ -f $work/stage/LICENSE.FEX ]] || cp "$work/FEX/LICENSE" "$work/stage/LICENSE.FEX" 2>/dev/null ||
    die "FEX's LICENSE not found in $work/FEX: needed in a package for others"
  mkdir -p "$data/dist"
  tar czf "$data/dist/$n" -C "$work" stage
  (cd "$data/dist" && sha256sum "$n" >"$n.sha256")
  echo "upload both to a GitHub release:"
  ls -l "$data/dist/$n" "$data/dist/$n.sha256"
}

# A packed build (cmd_pack) instead of building: checked against its .sha256 before it is unpacked; the current stage
# is kept as stage.prev.
cmd_fetch() {
  local src=${1:-${FRAME_VRC_FEX_URL:-}} tmp f
  tmp=$(mktemp -d); _TMP_DIRS+=("$tmp")
  [[ -n $src ]] || die "usage: frame-vrc fetch https://.../fex-<version>-steamframe-aarch64.tar.gz | FILE.tar.gz (its .sha256 next to it)"
  f=$(get_checked "$src" "$tmp") || exit 1  # it said why
  [[ $(tar tzf "$f" | sed 's|^\./||; s|/.*||' | sort -u) == stage ]] || die "unexpected archive layout (not a stage/ folder)"
  tar xzf "$f" -C "$tmp"
  for f in $bins; do [[ -s $tmp/stage/usr/bin/$f ]] || die "download has no usr/bin/$f"; done
  for f in $files; do [[ -s $tmp/stage/$f ]] || die "download has no $f"; done
  "$tmp/stage/usr/bin/FEXGetConfig" --version >/dev/null || die "the downloaded FEX does not run on this machine"
  mkdir -p "$work"
  [[ -d $work/stage ]] && { rm -rf "$work/stage.prev"; mv "$work/stage" "$work/stage.prev"; }
  mv "$tmp/stage" "$work/stage"
  asset_of "$src" >"$work/stage/ASSET"
  rm -rf "$tmp"  # the EXIT trap may be another's by then (pkg_fetch sets its own)
  echo "fetched: $(describe "$work/stage")"
}

# ---- commands: settings ---------------------------------------------------------------------------------------
# While a video plays in the game: is the plugin loaded and the hardware decoder open?
# DFR check, from the next VRChat start: magenta dots where the eyes look (DXVK_GAZE_DOT) and DXVK's log with the
# GazeVRS lines (DXVK_GAZE_DEBUG) in $data/dfrtest. off: both gone. A new FEX copy (setup, update) is without them.
cmd_dfrtest() {
  local t=$data/dfrtest g=$HOME/.local/share/frame-pcvr/gaze/frame-gaze-v1.bin
  [[ -f $pfex/emulator.json ]] || die "the PCVR version is not set up: frame-vrc setup"
  case ${1:-status} in
    on|off)
      mkdir -p "$t"
      python3 -I - "$pfex/emulator.json" "$1" "Z:$t" <<'PYE' || die "could not change $pfex/emulator.json"
import json, sys
p, mode, log = sys.argv[1:]
with open(p) as f:
    e = json.load(f)
ce = e["emulator_v0"]["container_environment"]
ce.update(DXVK_GAZE_DOT="1" if mode == "on" else "0", DXVK_GAZE_DEBUG="1" if mode == "on" else "0")
if mode == "on":  # Proton turns DXVK's log off unless it is set
    ce.update(DXVK_LOG_PATH=log, DXVK_LOG_LEVEL="info")
else:
    ce.pop("DXVK_LOG_PATH", None)
    ce.pop("DXVK_LOG_LEVEL", None)
with open(p, "w") as f:
    json.dump(e, f, indent=2)
PYE
      [[ $1 == on ]] && rm -f "$t"/*.log && echo "DFR test on: start VRChat; magenta dots follow your eyes in the 3D view (not in menus). Then: frame-vrc dfrtest" ||
        echo "DFR test off (from the next VRChat start)" ;;
    status)
      echo "  test mode   $(grep -q '"DXVK_GAZE_DOT": "1"' "$pfex/emulator.json" && echo on || echo off)"
      if pgrep -x VRChat.exe >/dev/null; then
        pgrep -f "$runtime/gaze-bridge" >/dev/null && echo "  bridge      running" || echo "  bridge      not running (starts once SteamVR's eye tracking is ready)"
        if [[ -f $g ]]; then
          # the bridge writes through a mapping: the contents change, the file time may not
          local a; a=$(cksum <"$g"); sleep 1
          [[ $(cksum <"$g") != "$a" ]] && echo "  gaze file   updating" || echo "  gaze file   not updating (eye tracking off or not calibrated?)"
        else echo "  gaze file   missing"; fi
      else echo "  VRChat      not running"; fi
      local l; l=$(ls -t "$t"/*d3d11.log 2>/dev/null | head -1) || true
      [[ -n $l ]] && { echo "  DXVK log    $l"; grep -a 'GazeVRS' "$l" | grep -av ':   ' | tail -6 | sed 's/^/    /'; } ||
        echo "  DXVK log    none yet (test mode on, then start VRChat)" ;;
    *) die "usage: frame-vrc dfrtest [on|off]" ;;
  esac
}

video_check() {
  local p n
  p=$(pgrep -x VRChat.exe | head -1) || die "VRChat is not running: play a video in a world, then run this"
  grep -q libgstvideo4linux2 "/proc/$p/maps" && echo "  plugin loaded" || echo "  plugin not loaded (no video played yet?)"
  n=$(find "/proc/$p/fd" -lname '/dev/video*' 2>/dev/null | wc -l)
  ((n > 0)) && echo "  hardware decoder open ($n)" || echo "  hardware decoder not open"
}


# The resolution frame-vrc keeps (RES) into SteamVR; the value before frame-vrc is kept once, for official/uninstall.
res_apply() {
  local cur want prev=$data/resolution.$appid.prev
  [[ -x $vrcmd ]] || die "SteamVR's vrcmd not found ($vrcmd)"
  cur=$(res_get) want=$(cfg RES)
  [[ -n $cur ]] || die "SteamVR did not answer: start SteamVR (VR mode) and try again"
  [[ -f $prev ]] || { mkdir -p "$data"; echo "$cur" >"$prev"; }
  [[ $cur == "$want" ]] || timeout 10 "$vrcmd" --set-settings-int "$reskey" "$want" >/dev/null
  [[ $(res_get) == "$want" ]] || die "SteamVR did not take $want"
  echo "$name render resolution: $want$([[ $cur == "$want" ]] || echo " (was $cur)")"
}
cmd_resolution() {
  local op=${1:-show} prev=$data/resolution.$appid.prev
  case $op in
    show) echo "$name render resolution: $(res_get) (frame-vrc: $(cfg RES)$([[ -f $prev ]] && echo ", before frame-vrc: $(cat "$prev")"))" ;;
    reset)
      [[ -x $vrcmd ]] || die "SteamVR's vrcmd not found ($vrcmd)"
      [[ -f $prev ]] || { echo "not changed by frame-vrc: $(res_get)"; return; }
      timeout 10 "$vrcmd" --set-settings-int "$reskey" "$(cat "$prev")" >/dev/null
      [[ $(res_get) == "$(cat "$prev")" ]] || die "SteamVR did not take the old value (start SteamVR)"
      rm -f "$prev"; echo "$name render resolution back to $(res_get)" ;;
    *)
      [[ $op =~ ^[0-9]+$ ]] && ((op >= 360 && op <= 4096)) || die "usage: frame-vrc resolution 1056|1440|1920 (advanced: 1600, 2160, any N 360-4096)"
      cfg_set RES "$op"
      # the official version keeps its own resolution; frame-vrc's applies when the community version is chosen
      if [[ $(edition) == official ]]; then echo "saved: $op (applies with the community version)"; return; fi
      res_apply
      echo "applies the next time the game starts" ;;
  esac
}

# The panel collects taps and sends them together: apply resolution=N
cmd_apply() {
  local kv
  for kv; do
    case ${kv%%=*} in
      resolution) cmd_resolution "${kv#*=}" ;;
      *) die "usage: frame-vrc apply resolution=N (the other settings are ji10me's tested ones)" ;;
    esac
  done
}

cmd_launch_options() {
  local op=${1:-show} prev=$data/launch-options.$appid.prev cur
  cur=$(opts_get)
  case $op in
    show) echo "$name ($appid): ${cur:-<empty>}"; ours "$cur" && echo "(set by frame-vrc)" || true ;;
    set)
      local want; want=$(run_line)
      [[ "$cur" == "$want" ]] && { echo "launch options: already set"; return; }
      # Keep what the user had, so clear puts it back.
      if [[ -n $cur ]] && ! ours "$cur"; then mkdir -p "$data"; printf '%s' "$cur" >"$prev"; echo "previous options kept in $prev"; fi
      opts_set "$want"
      echo "launch options: frame-vrc-run %command%" ;;
    clear)
      local back=""; [[ -f $prev ]] && back=$(cat "$prev")
      ours "$cur" || [[ -z $cur ]] || die "the current options were not set by frame-vrc; not touching them"
      opts_set "$back"
      rm -f "$prev"
      [[ -n $back ]] && echo "launch options: restored your own" || echo "launch options: cleared (as Steam ships them)" ;;
    *) die "usage: frame-vrc launch-options show|set|clear" ;;
  esac
}

# ---- swap -----------------------------------------------------------------------------------------------------
# SteamOS swaps to zram (half the RAM, 8 GB) first, then to /home/swapfile: 1 GB as shipped (swapfile.service), 8 GB
# through a systemd drop-in. Both need root, and frame-vrc never uses sudo: it shows the commands to run in a terminal
# (VRChat closed: swapoff moves the file's pages back into RAM).
swap_dropin=/etc/systemd/system/swapfile.service.d/50-size.conf
swap_mb() { awk -v f="$1" '$1 == f {print int($3 / 1024)}' /proc/swaps; }  # a swap's size in MB (empty: not on)
cmd_swap() {
  local file zram; file=$(swap_mb /home/swapfile) zram=$(swap_mb /dev/zram0)
  case ${1:-} in
    "")
      echo "swap: zram ${zram:-0} MB, swap file ${file:-0} MB$([[ -f $swap_dropin ]] && echo " (8 GB setting: $swap_dropin)")"
      echo "change: frame-vrc swap 8g | 1g (shows the commands; they need root)" ;;
    8g | 1g)
      if [[ $1 == 8g ]]; then  # 8 GB of file plus room for Steam's updates (ji10me's setup keeps 20 GB free)
        local avail; avail=$(df -Pm /home | awk 'NR==2{print $4}')
        ((avail - ${file:-0} > 8192 + 20480)) || echo "frame-vrc: only $((avail / 1024)) GB free in /home: the 8 GB swap file would leave too little" >&2
      fi
      echo "Run these in a terminal (Konsole) with VRChat closed; each sudo asks for your password:"
      if [[ $1 == 8g ]]; then
        echo "  sudo mkdir -p ${swap_dropin%/*}"
        echo "  printf '[Service]\nExecStart=\nExecStart=/usr/bin/mkswap --file /home/swapfile --size 8192M\n' | sudo tee $swap_dropin"
      else
        echo "  sudo rm -f $swap_dropin"
      fi
      echo "  sudo swapoff /home/swapfile && sudo rm /home/swapfile"
      echo "  sudo systemctl daemon-reload && sudo systemctl restart swapfile.service home-swapfile.swap"
      echo "then: frame-vrc swap  (the swap file: $([[ $1 == 8g ]] && echo 8192 || echo 1024) MB)" ;;
    *) die "usage: frame-vrc swap [8g|1g]" ;;
  esac
}

# ---- commands: play, measure, update, undo --------------------------------------------------------------------
# Through Steam's client API (as its Play button). Not "steam steam://... &": started from the VR panel, this runs in a
# systemd unit, and systemd stops a backgrounded helper when we exit, before it passes the URL on. Then waits for
# the game's launch to show up (Steam's reaper with AppId=438100, or VRChat.exe).
cmd_launch() {
  running && { echo "$name is already running"; return; }
  echo "asking Steam to start $name ..."
  steamapi run "$appid" >/dev/null 2>&1 || timeout 30 steam "steam://rungameid/$appid" >/dev/null 2>&1 || true
  # the build for the chosen version is not there yet: Steam updates VRChat first, then starts it
  if [[ $(edition) == community && ! -f $gamedir/$name.exe ]] || [[ $(edition) == official && $(game_build) == pc ]]; then
    echo "Steam updates $name first (shown in Steam), then starts it"; return
  fi
  local i; for i in $(seq 1 20); do running && { echo "$name is starting (the first world join takes a few minutes)"; return; }; sleep 1; done
  die "Steam did not start $name: start it from the Steam library"
}

cmd_bench() {
  mkdir -p "$data/bench"
  local stamp out log
  stamp=$(date +%Y%m%d-%H%M%S)
  log="$data/bench/$appid-$stamp.log" out="$data/bench/$appid-$stamp.md"
  echo "Start $name from Steam now; sampling begins when it starts and ends when it exits (every 5 s, read only)."
  touch "$log.start"  # logs written after this are this session's
  local summary
  summary=$(python3 -I "$lib/game-bench.py" "$appid" "$log" 600) || die "no game launch seen within 10 minutes"
  # EAC and the game's own milestones: counts only, never log contents.
  local eac="$apps/compatdata/$appid/pfx/drive_c/users/steamuser/AppData/Roaming/EasyAntiCheat"
  local keys
  # EAC keeps its launcher log a few folders down; the game folder also holds big caches, so only its top level.
  keys=$({ find "$eac" -type f -name '*.log' -newer "$log.start" -print0
           find "$gamelog" -maxdepth 1 -type f -name '*.txt' -newer "$log.start" -print0; } 2>/dev/null |
    xargs -0r grep -hoE "Launcher finished with: [0-9]+|AntiCheat Session (Begin|End): [A-Za-z]+|Finished entering world|null client" |
    sort | uniq -c | sed 's/^ */- /')
  {
    echo "## frame-vrc bench: $name"
    echo
    echo "| | |"
    echo "|---|---|"
    echo "| frame-vrc | $VERSION |"
    echo "| SteamOS | $(sed -n 's/^VERSION_ID=//p' /etc/os-release) build $(sed -n 's/^BUILD_ID=//p' /etc/os-release), kernel $(uname -r) |"
    echo "| FEX | $(describe "$pfex") |"
    echo "| settings | resolution $(res_get), runtime $(cat "$pfex/.frame-vrc-runtime" 2>/dev/null) |"
    echo "$summary"
    echo
    echo "EAC / game milestones:"
    echo "${keys:-- none found}"
    rm -f "$log.start"
    echo
    echo "How it went (fill in): world, players around, smoothness, crashes:"
  } >"$out"
  cat "$out"
  echo
  echo "saved: $out (raw samples: $log)"
}

# A release through get.sh (the same as a new install; settings are kept): the latest, VERSION (an older one too, to
# go back) or --rc, the newest release or pre-release. Its install.sh then runs "packages".
cmd_update() {
  local ver=${1:-} ref=main
  # a pre-release stays on the newest release or pre-release ("latest" is the last stable one, maybe older)
  [[ -n $ver || $VERSION != *-rc* ]] || ver=--rc
  if [[ $ver == --rc ]]; then
    ver=$(release_json "?per_page=30" | python3 -I -c '
import json, re, sys
def key(tag):  # 0.8.0-rc2 < 0.8.0
    m = re.fullmatch(r"v(\d+)\.(\d+)\.(\d+)(?:-rc(\d+))?", tag)
    return (int(m[1]), int(m[2]), int(m[3]), int(m[4] or 1 << 30)) if m else ()
print(max((r["tag_name"] for r in json.load(sys.stdin) if not r["draft"]), key=key)[1:])') ||
      die "could not list the releases (github.com reachable?)"
  fi
  if [[ -n $ver ]]; then
    [[ $ver =~ ^[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?$ ]] || die "usage: frame-vrc update [VERSION|--rc]"
    ref=v$ver  # that release's own get.sh: older ones know only their own version format
  fi
  # Versions before 0.8.0-rc4 know nothing of frame-vrc-run or the private FEX: the official version first, then set
  # that version up with its own commands.
  if [[ $ver =~ ^0\.[0-7]\. || $ver =~ ^0\.8\.0-rc[0-3]$ ]]; then
    echo "going back to $ver: the official version first (set up $ver afterwards with its own commands)"
    cmd_official --quiet
  fi
  curl -fsSL "https://raw.githubusercontent.com/$repo/$ref/get.sh" | FRAME_VRC_VERSION=$ver bash ||
    die "update failed${ver:+ (is there a release $ver?)}"
}

# After an update (install.sh runs this), for a community version already set up: this release's packages, the
# patched FEX and the Proton copy where they changed, the launch options in this version's form. Nothing else in Steam.
cmd_packages() {
  refresh_paths
  local cur
  if running; then
    echo "frame-vrc: $name is running: the packages are updated by the next frame-vrc setup" >&2
  elif [[ -x $pfex/fex-compat-tool || -d $dfr_dir ]]; then
    cur=$(opts_get 2>/dev/null || true)
    if [[ $(compat_tool) != "$dfr_tool" && $cur == *EAC_LAUNCHERDIR=* ]]; then
      # frame-vrc 0.7 on plain Proton Experimental: it keeps working as it is until the user chooses
      echo "frame-vrc 0.8: choose the PCVR version (frame-vrc setup) or the official one (frame-vrc official)"
    else
      # in a subshell: a step that stops (Steam not answering, disk full) leaves the rest as it was, never half moved
      (
        packages_get
        runtime_install
        pfex_install
        [[ ! -d $dfr_dir ]] || dfr_copy
        if ours "$cur" && [[ $cur != "$(run_line)" ]]; then opts_set "$(run_line)"; echo "launch options: frame-vrc-run %command%"; fi
        [[ $(compat_tool) != "$dfr_tool" ]] || steam_fex_restore || true
      ) || echo "frame-vrc: not everything was updated; frame-vrc setup finishes it" >&2
    fi
  fi
  local f d v
  f=$(describe "$pfex") || true
  d=$(cut -d' ' -f2 "$dfr_pkg/VERSION" 2>/dev/null) || true
  v=$(head -1 "$video_pkg/VERSION" 2>/dev/null | cut -d' ' -f2 | tr -d :) || true
  echo "packages: FEX ${f:-not set up}, DFR ${d:-none}, H.264 ${v:-none}"
}

cmd_panel() {
  [[ -x $here/frame-vrc-panel ]] || die "the VR panel is not built (install.sh builds it; needs cmake, ninja, g++)"
  exec "$here/frame-vrc-panel" --show "$@"
}

# Everything frame-vrc added goes: VRChat back on Lepton (the official version: Proton Experimental alone cannot run
# it), your launch options and resolution, the Proton copy, the patched FEX, frame-vrc. --purge: also its downloads,
# settings and bench reports. Steam must answer: a game left on a deleted tool cannot start.
cmd_uninstall() {
  local purge=false listed=false
  [[ "${1:-}" == --purge ]] && purge=true
  cmd_official --quiet
  # before anything is deleted: frame-vrc 0.7's build out of Steam's FEX-Emu (its backup is in $work)
  steam_fex_restore || die "not uninstalled: Steam's FEX-Emu must get Valve's build back first (see above)"
  steam_lists_copy && listed=true
  [[ -d $dfr_dir ]] && echo "removed $dfr_name"
  rm -rf "$dfr_dir" "$dfr_dir.new" "$pfex" "$pfex.new"
  # The bridge's gaze file (its folders only when empty: other tools use frame-pcvr too), and GStreamer's plugin lists
  # in the game's prefix that name the H.264 package (Proton makes them again at the next start).
  rm -f "$HOME/.local/share/frame-pcvr/gaze/frame-gaze-v1.bin" "$apps/compatdata/$appid/fex-emu/ThunksDB.json"
  rmdir "$HOME/.local/share/frame-pcvr/gaze" 2>/dev/null && rmdir "$HOME/.local/share/frame-pcvr" 2>/dev/null || true
  local f
  for f in "$apps/compatdata/$appid/gstreamer-1.0"/registry.*; do
    [[ -f $f ]] && { [[ $f == *.frame-vrc-old ]] || grep -qF "$video_pkg" "$f"; } && rm -f "$f"
  done
  rm -f "$HOME/.local/bin/frame-vrc" "$HOME/.local/share/applications/frame-vrc.desktop"
  # a panel opened from the app list (when the panel started this, it runs detached and carries on)
  pkill -TERM -x frame-vrc-panel 2>/dev/null || true
  if $purge; then
    rm -rf "$work" "$data"
    echo "removed $work and $data"
  else
    echo "kept $work (FEX build) and $data (settings, packages, bench reports); --purge removes them"
  fi
  # Steam lists compatibility tools until it restarts: chosen in Steam after this, the deleted copy fails to launch
  if $listed; then
    echo "restarting Steam so it no longer lists $dfr_name (SteamVR restarts with it, about a minute)"
    steamapi restart >/dev/null 2>&1 || echo "frame-vrc: restart Steam yourself to drop $dfr_name from its list" >&2
  fi
  [[ $here == "$HOME/.local/lib/frame-vrc" ]] && rm -rf "$here"
  echo "frame-vrc uninstalled"
}

usage() {
  cat <<EOF
frame-vrc $VERSION: Standalone PC VRChat on the Steam Frame (powered by ji10me's PCVR runtime)

Usage:
  frame-vrc setup                   Configure and switch $name to the PCVR version ("$dfr_name",
                                    isolated FEX, render resolution 1920, launch options)
  frame-vrc official                Revert $name to the official Android version (Lepton) and
                                    restore previous launch options and resolution
  frame-vrc panel                   Open the SteamVR dashboard panel
  frame-vrc next [--json]           Show the next recommended setup action
  frame-vrc status [--json]         Show current version and component status
  frame-vrc resolution 1056|1440|1920
                                    Set per-eye render resolution (Performance / Balanced / Quality)
  frame-vrc launch                  Launch $name
  frame-vrc doctor [--json]         Run environment health checks and diagnostics
  frame-vrc update [VERSION|--rc]   Update frame-vrc and runtime packages
  frame-vrc uninstall [--purge]     Revert to the official build and uninstall frame-vrc
                                    (--purge also removes downloaded packages and state files)

Advanced:
  frame-vrc resolution 1600|2160|N  Set custom per-eye render resolution (360-4096)
  frame-vrc video check             Check if H.264 hardware decoding is active during video playback
  frame-vrc dfrtest [on|off]        Toggle DFR debug overlay (gaze indicator and DXVK DFR log)
  frame-vrc install-deps            Prompt Steam to install FEX-Emu, Proton Experimental, and EAC Runtime
  frame-vrc setup-status [--json]   Show current or last setup wizard status
  frame-vrc setup-reopen            Ask a waiting setup wizard to reopen the current Steam install prompt
  frame-vrc store                   Open VRChat's Steam store page
  frame-vrc swap [8g|1g]            Show swap status or print root commands to configure 8 GB / 1 GB swap
  frame-vrc build [--jobs N] | fetch URL|FILE | pack
                                    Build, fetch, or package the patched FEX binary archive
  frame-vrc setup [FEX] --dfr X --video X --mf X
                                    Run setup using custom package URLs or local archives
  frame-vrc launch-options show|set|clear
  frame-vrc bench                   Record a session performance report (CPU, memory, temperature, FPS)
EOF
}

[[ $(id -u) != 0 ]] || die "do not run as root"
cmd=${1:-help}
shift || true
case $cmd in
  setup | community) cmd_setup "$@" ;;
  official) cmd_official ;;
  status) cmd_status "$@" ;;
  resolution) cmd_resolution "$@" ;;
  dfrtest) cmd_dfrtest "$@" ;;
  video) [[ ${1:-} == check ]] || die "usage: frame-vrc video check (H.264 hardware video is always on in 0.8)"; video_check ;;
  apply) cmd_apply "$@" ;;
  launch) cmd_launch ;;
  doctor) cmd_doctor "$@" ;;
  update) cmd_update "$@" ;;
  packages) cmd_packages ;;
  next) cmd_next "$@" ;;
  store) steam_url "steam://store/$appid"; echo "Steam shows $name's store page: add it to the library, then: frame-vrc next" ;;
  swap) cmd_swap "$@" ;;
  panel) cmd_panel "$@" ;;
  install-deps) cmd_install_deps "$@" ;;
  setup-status) cmd_setup_status "$@" ;;
  setup-reopen) cmd_setup_reopen "$@" ;;
  build) cmd_build "$@" ;;
  fetch) cmd_fetch "$@"; pin "$work/stage" "$1" ;;
  pack) cmd_pack ;;
  launch-options) cmd_launch_options "$@" ;;
  bench) cmd_bench ;;
  uninstall) cmd_uninstall "$@" ;;
  version) echo "$VERSION" ;;
  help | -h | --help) usage ;;
  fex | proton | mode | switch) die "'$cmd' is gone in 0.8: frame-vrc setup (the PCVR version) or frame-vrc official" ;;
  dfr | tune) die "'$cmd' is gone: frame-vrc uses ji10me's tested runtime settings as they are" ;;
  *) usage; exit 1 ;;
esac
